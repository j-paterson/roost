{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/core/src/*"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ES2018", "ES2021.String"]
  },
  "include": ["packages/core/src/**/*.ts", "packages/core/src/**/*.tsx", "packages/core/src/**/*.d.ts"]
}
