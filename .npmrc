# Supply-chain hardening: refuse to install package versions that have
# been published less than 3 days ago. Blunts the window where a fresh
# malicious release can land in `npm install` before maintainers + the
# registry catch and unpublish it.
#
# Documented at https://docs.npmjs.com/cli/v11/using-npm/config
# under `min-release-age`. The value is a number of days.
#
# Requires npm 11.10.0+ (Feb 2026). Silently ignored on older npm;
# upgrade with `npm i -g npm@latest`.
#
# NOTE: npm's current implementation has no per-package exclusion
# allowlist. If you need to bypass the cooldown for a specific scope
# (e.g., internal packages getting urgent security patches), either
# (a) pass `--min-release-age=0` for the affected install only, or
# (b) switch to pnpm which supports `minimumReleaseAgeExclude`.
# This project is single-package (no workspaces), so no scopes to
# exempt today — kept the note for when that changes.
min-release-age=3
