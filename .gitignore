node_modules/
dist/
main.js
styles.css
*.js.map
test/.venv/
.claude/
.worktrees/

# Internal docs — NOT shipped. Public repo ships only README.md + ARCHITECTURE.md.
# These dirs/files are kept locally (planning, agent instructions) but never tracked.
CLAUDE.md
AGENTS.md
REVIEW.md
docs/

# Local build/test/verify logs
.build.log
.e2e-*.log
.verify-output.txt

# E2E vault working copies managed by wdio-obsidian-service
.e2e-vault/
# X session cookies for live e2e tests — NEVER commit (session credentials, expire ~yearly)
tests/e2e/.x-cookies.json
# Captured X GraphQL shapes from the bookmark-folders live spec (diagnostic artifact)
tests/e2e/.x-bookmark-folders-capture.json
# Instagram session cookies for live e2e tests — NEVER commit
tests/e2e/.ig-cookies.json
# Captured Instagram API shapes from the discovery live spec (diagnostic artifact)
tests/e2e/.ig-discovery-capture.json
# Streamed live-sync log from the Instagram production sync e2e (diagnostic artifact)
tests/e2e/.ig-sync-live.log
# Reddit session cookies for live e2e tests — NEVER commit (session credentials)
tests/e2e/.reddit-cookies.json
# Streamed live-sync log + captured API shapes from the Reddit sync e2e (diagnostic artifacts)
tests/e2e/.reddit-sync-live.log
tests/e2e/.reddit-discovery-capture.json
# Video-mux proof e2e: streamed log + copied-out video.mp4/raw.json artifacts
tests/e2e/.reddit-mux-live.log
tests/e2e/.reddit-video-mux-proof/
# Link-preview backfill live e2e: streamed log (diagnostic artifact)
tests/e2e/.link-preview-live.log
# Local secrets for ad-hoc test scripts (Spotify credentials, etc.)
.env
.env.*
# wdio-obsidian-service Obsidian version cache
.obsidian-cache/
# WDIO logs
wdio-*.log
# WDIO test output
test-results/

# Promo assets (regenerate with npm run promo:experiments)
docs/promo/screenshots/*.png
docs/promo/bursts/
docs/promo/videos/*.mp4
docs/promo/videos/.concat-list.txt

# Python bytecode cache
scripts/__pycache__/
*.pyc
.superpowers/

# Large eval outputs (regenerable pipeline results, not source)
tests/eval/*-results.json
tests/eval/*-results-highfloor.json
tests/eval/results-after-blended.json

# Vendored vault-search tool — built artifacts and deps never committed
tools/vault-search/node_modules/
tools/vault-search/dist/
# Exceptions for the vendored vault-search tool — .env.example is a template (not secret);
# tools/vault-search/docs/ is the vendor's own documentation, not internal planning docs.
!tools/vault-search/.env.example
!tools/vault-search/docs/
!tools/vault-search/docs/**
tests/e2e/.ig-rest-probe.json

# Large ML training checkpoints — live in the vault (.roost/build/checkpoints), never in git
checkpoints/
